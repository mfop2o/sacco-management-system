# JWT
JWT_SECRET=your-256-bit-secret-key-change-this

# Database
POSTGRES_DB=sacco_db
POSTGRES_USER=sacco_user
POSTGRES_PASSWORD=sacco_password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sacco_db
SPRING_DATASOURCE_USERNAME=sacco_user
SPRING_DATASOURCE_PASSWORD=sacco_password

# Redis
SPRING_DATA_REDIS_HOST=redis

# RabbitMQ
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_USERNAME=sacco_user
SPRING_RABBITMQ_PASSWORD=sacco_password

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
